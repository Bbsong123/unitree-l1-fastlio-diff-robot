<launch>
  <!-- 1. 底层底盘速度转发与看门狗节点 (/target_cmd_vel -> /cmd_vel) -->
  <node pkg="robot_nav" type="base_controller_node" name="base_controller_node" output="screen">
    <rosparam command="load" file="$(find robot_nav)/config/nav_params.yaml" />
    <param name="input_topic" value="/target_cmd_vel" />
    <param name="output_topic" value="/cmd_vel" />
  </node>

  <!-- 2. 定点跟踪算法节点 (/Odometry + /desire_position -> /target_cmd_vel) -->
  <node pkg="robot_nav" type="point_tracker_node" name="point_tracker_node" output="screen">
    <rosparam command="load" file="$(find robot_nav)/config/nav_params.yaml" />
    <param name="odom_topic" value="/Odometry" />
    <param name="target_topic" value="/desire_position" />
    <param name="cmd_topic" value="/target_cmd_vel" />
  </node>
</launch>
