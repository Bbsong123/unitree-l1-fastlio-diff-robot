<launch>
  <!-- Only serial driver: no radar, navigation or automatic motion. -->
  <arg name="port" default="/dev/wheeltec_controller"/>
  <arg name="baud" default="115200"/>
  <node pkg="turn_on_wheeltec_robot" type="wheeltec_robot_node" name="wheeltec_robot" output="screen">
    <param name="usart_port_name" value="$(arg port)"/>
    <param name="serial_baud_rate" type="int" value="$(arg baud)"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="robot_frame_id" value="base_footprint"/>
    <param name="gyro_frame_id" value="gyro_link"/>
  </node>
</launch>
